/* ShipyardHUD.uss - Concept-Matched Unity 6 UI Toolkit Stylesheet */

.hud-root {
    position: relative;
    width: 100%;
    height: 100%;
    flex-direction: column;
    justify-content: flex-start;
    align-items: stretch;
    background-color: rgba(0, 0, 0, 0);
}

.gameplay-hud-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0);
}

.hidden {
    display: none;
}

/* =========================================================
   TOP-LEFT: MINIMAL 3-BAR VITALS + DIAMOND OBJECTIVE
   ========================================================= */

.left-hud-column {
    position: absolute;
    left: 18px;
    top: 16px;
    width: 270px;
    flex-direction: column;
}

.vitals-card {
    flex-direction: column;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 10px;
    padding-right: 10px;
    background-color: rgba(8, 14, 24, 0.52);
    border-width: 1px;
    border-color: rgba(145, 195, 235, 0.25);
    border-radius: 7px;
    margin-bottom: 8px;
}

.vital-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 5px;
    height: 14px;
}

.vital-glyph {
    width: 16px;
    font-size: 12px;
    -unity-text-align: middle-center;
    margin-right: 6px;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9);
}

.vital-glyph-health { color: #FF5555; }
.vital-glyph-stamina { color: #A6F254; }
.vital-glyph-rad { color: #36F0D8; }

.vital-bar-track {
    flex-grow: 1;
    height: 8px;
    border-radius: 4px;
    background-color: rgba(6, 10, 18, 0.72);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.16);
    overflow: hidden;
    flex-direction: row;
    align-items: stretch;
}

.vital-bar-fill {
    height: 100%;
    border-radius: 3px;
}

.health-bar-fill { background-color: #E14242; }
.stamina-bar-fill { background-color: #84D444; }
.rad-bar-fill { background-color: #2CD4C8; }

.vital-value-label {
    width: 48px;
    margin-left: 6px;
    font-size: 10px;
    -unity-font-style: bold;
    color: rgba(235, 245, 255, 0.92);
    -unity-text-align: middle-right;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.95);
}

.mission-card {
    flex-direction: column;
    padding: 6px 8px;
    background-color: rgba(6, 12, 20, 0.36);
    border-radius: 6px;
}

.mission-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 3px;
}

.mission-diamond {
    color: #5CE8FF;
    font-size: 12px;
    margin-right: 6px;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.95);
}

.mission-title {
    font-size: 11px;
    -unity-font-style: bold;
    color: #5CE8FF;
    letter-spacing: 0.7px;
    flex-grow: 1;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.95);
}

.mission-progress {
    font-size: 10px;
    -unity-font-style: bold;
    color: #F5A623;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.95);
}

.objective-label {
    font-size: 12px;
    -unity-font-style: bold;
    color: #F2F7FC;
    white-space: normal;
    margin-bottom: 2px;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.95);
}

.mission-desc {
    font-size: 10px;
    color: rgba(205, 224, 238, 0.86);
    white-space: normal;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.95);
}

/* =========================================================
   TOP-CENTER: COMPACT UTILITY STRIP + SLIM BOSS BAR
   ========================================================= */

.top-center-column {
    position: absolute;
    top: 12px;
    left: 300px;
    right: 186px;
    flex-direction: column;
    align-items: center;
}

.top-bar {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    padding: 4px 10px;
    background-color: rgba(8, 14, 24, 0.46);
    border-width: 1px;
    border-color: rgba(140, 185, 220, 0.2);
    border-radius: 14px;
    margin-bottom: 8px;
}

.top-bar-telemetry {
    flex-direction: row;
    align-items: center;
    margin-right: 10px;
}

.telemetry-chip {
    font-size: 10px;
    -unity-font-style: bold;
    color: rgba(218, 232, 244, 0.88);
    margin-right: 8px;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9);
}

.shift-chip { color: #F5A623; }
.score-chip { color: #5CE8FF; margin-right: 0; }

.top-bar-actions {
    flex-direction: row;
    align-items: center;
}

.utility-btn {
    height: 22px;
    padding-left: 8px;
    padding-right: 8px;
    margin-left: 4px;
    font-size: 9px;
    -unity-font-style: bold;
    color: #DCE9F5;
    background-color: rgba(16, 26, 42, 0.72);
    border-width: 1px;
    border-color: rgba(120, 170, 210, 0.35);
    border-radius: 4px;
}

.utility-btn:hover {
    background-color: rgba(35, 58, 92, 0.88);
    border-color: #5CE8FF;
}

.utility-btn-warn {
    border-color: rgba(225, 80, 72, 0.55);
    color: #FFB4AE;
}

.boss-card {
    width: 420px;
    flex-direction: column;
    padding: 6px 14px 8px 14px;
    background-color: rgba(10, 14, 22, 0.58);
    border-width: 1px;
    border-color: rgba(225, 110, 72, 0.45);
    border-radius: 6px;
}

.boss-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
}

.boss-name-label {
    font-size: 12px;
    -unity-font-style: bold;
    color: #FFE4D4;
    letter-spacing: 1px;
}

.boss-health-label {
    font-size: 10px;
    -unity-font-style: bold;
    color: #F59E3D;
}

.boss-bar-track {
    width: 100%;
    height: 10px;
    border-radius: 5px;
    background-color: rgba(14, 10, 14, 0.78);
    border-width: 1px;
    border-color: rgba(255, 175, 130, 0.3);
    overflow: hidden;
}

.boss-health-fill {
    height: 100%;
    background-color: #DF4A2F;
    border-radius: 4px;
}

.toast-banner {
    margin-top: 8px;
    padding: 6px 16px;
    background-color: rgba(8, 16, 28, 0.84);
    border-width: 1px;
    border-color: rgba(92, 232, 255, 0.45);
    border-radius: 6px;
}

.toast-label {
    font-size: 12px;
    -unity-font-style: bold;
    color: #F2F9FF;
    white-space: normal;
}

/* =========================================================
   TOP-RIGHT: 146x146 CIRCULAR TACTICAL RADAR
   ========================================================= */

.radar-card {
    position: absolute;
    right: 18px;
    top: 16px;
}

.radar-circle {
    width: 146px;
    height: 146px;
    border-radius: 73px;
    background-color: rgba(12, 20, 32, 0.72);
    border-width: 1.5px;
    border-color: rgba(130, 185, 225, 0.55);
    overflow: hidden;
    justify-content: center;
    align-items: center;
}

.radar-ring {
    position: absolute;
    border-width: 1px;
    border-color: rgba(130, 175, 210, 0.25);
    background-color: rgba(0, 0, 0, 0);
}

.radar-ring-outer { width: 112px; height: 112px; border-radius: 56px; }
.radar-ring-mid { width: 76px; height: 76px; border-radius: 38px; }
.radar-ring-inner { width: 38px; height: 38px; border-radius: 19px; }

.radar-axis-h {
    position: absolute;
    width: 100%;
    height: 1px;
    background-color: rgba(130, 175, 210, 0.16);
}

.radar-axis-v {
    position: absolute;
    width: 1px;
    height: 100%;
    background-color: rgba(130, 175, 210, 0.16);
}

.radar-blips-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.radar-player-arrow {
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: #FFFFFF;
    border-width: 1.5px;
    border-color: #5CE8FF;
}

/* =========================================================
   BOTTOM-CENTER: CONTEXTUAL PROMPT & SLIM ACTION STRIP
   ========================================================= */

.bottom-center-column {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 14px;
    flex-direction: column;
    align-items: center;
}

.contextual-prompt-bar {
    padding: 5px 14px;
    margin-bottom: 8px;
    background-color: rgba(8, 16, 28, 0.72);
    border-width: 1px;
    border-color: rgba(92, 232, 255, 0.45);
    border-radius: 12px;
}

.contextual-prompt-label {
    font-size: 12px;
    -unity-font-style: bold;
    color: #FFF4CC;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.95);
}

.bottom-dock {
    flex-direction: row;
    justify-content: center;
}

.toolbar {
    flex-direction: row;
    padding: 4px 8px;
    background-color: rgba(8, 14, 24, 0.56);
    border-width: 1px;
    border-color: rgba(140, 185, 220, 0.25);
    border-radius: 8px;
}

.toolbar-slot {
    height: 26px;
    padding-left: 10px;
    padding-right: 10px;
    margin-left: 3px;
    margin-right: 3px;
    font-size: 10px;
    -unity-font-style: bold;
    color: #DCE9F5;
    background-color: rgba(16, 26, 40, 0.78);
    border-width: 1px;
    border-color: rgba(120, 165, 200, 0.3);
    border-radius: 4px;
}

.toolbar-slot.active {
    border-color: #5CE8FF;
    color: #5CE8FF;
    background-color: rgba(20, 48, 70, 0.86);
}

/* =========================================================
   MODAL OVERLAYS (TITLE, PAUSE, PROTOCOL, LOGBOOK, ENDGAME)
   ========================================================= */

.modal-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(4, 8, 16, 0.58);
    justify-content: center;
    align-items: center;
}

.modal-card {
    width: 440px;
    padding: 24px 28px;
    background-color: rgba(10, 18, 30, 0.92);
    border-width: 1.5px;
    border-color: rgba(92, 232, 255, 0.4);
    border-radius: 12px;
    flex-direction: column;
    align-items: stretch;
}

.title-logo, .modal-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: #F2F9FF;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.title-subtitle, .modal-subtitle {
    font-size: 11px;
    -unity-font-style: bold;
    color: #5CE8FF;
    letter-spacing: 1.4px;
    -unity-text-align: middle-center;
    margin-bottom: 16px;
}

.callsign-input, .settings-slider {
    margin-bottom: 12px;
    color: #EAF4FC;
}

.auth-status-label, .protocol-line, .endgame-summary {
    font-size: 11px;
    color: #C2D6E8;
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 12px;
}

.primary-btn {
    height: 36px;
    margin-top: 6px;
    font-size: 12px;
    -unity-font-style: bold;
    color: #07101A;
    background-color: #F5A623;
    border-width: 0;
    border-radius: 6px;
}

.primary-btn:hover {
    background-color: #FFB844;
}

.secondary-btn, .perk-btn {
    height: 30px;
    margin-top: 6px;
    font-size: 11px;
    -unity-font-style: bold;
    color: #E2EEF8;
    background-color: rgba(24, 38, 58, 0.88);
    border-width: 1px;
    border-color: rgba(120, 175, 215, 0.35);
    border-radius: 5px;
}

.logbook-stats-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 10px;
}

.logbook-stat-chip {
    font-size: 11px;
    -unity-font-style: bold;
    color: #F5A623;
}

.logbook-acts-container {
    max-height: 150px;
    margin-bottom: 10px;
    padding: 6px;
    background-color: rgba(6, 12, 20, 0.65);
    border-radius: 5px;
}

.perk-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-bottom: 10px;
}

.perk-btn {
    width: 48%;
}
