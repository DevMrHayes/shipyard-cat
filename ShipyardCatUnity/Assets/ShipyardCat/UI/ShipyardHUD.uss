/* ShipyardHUD.uss - Unity 6 UI Toolkit Stylesheet */

.hud-root {
    position: relative;
    width: 100%;
    height: 100%;
    flex-direction: column;
    justify-content: flex-start;
    align-items: stretch;
    background-color: rgba(0, 0, 0, 0);
}

.hidden {
    display: none;
}

/* =========================================================
   TOP-LEFT: VITALS CARD
   ========================================================= */

.vitals-card {
    position: absolute;
    left: 20px;
    top: 18px;
    width: 260px;
    flex-direction: column;
    padding-top: 10px;
    padding-bottom: 8px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: rgba(8, 14, 24, 0.38);
    border-width: 1px;
    border-color: rgba(145, 190, 225, 0.22);
    border-radius: 8px;
    transition-duration: 0.18s;
}

.vital-row {
    flex-direction: column;
    margin-bottom: 7px;
}

.vital-row--last {
    margin-bottom: 0px;
}

.vital-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 3px;
}

.vital-label {
    font-size: 10px;
    -unity-font-style: bold;
    color: rgba(225, 238, 248, 0.88);
    letter-spacing: 1px;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9);
}

.vital-value {
    font-size: 10px;
    -unity-font-style: bold;
    color: rgba(240, 246, 252, 0.92);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9);
}

.vital-bar-track {
    width: 100%;
    height: 10px;
    border-radius: 5px;
    background-color: rgba(6, 10, 18, 0.56);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    overflow: hidden;
    flex-direction: row;
    align-items: stretch;
}

.vital-bar-fill {
    height: 100%;
    border-radius: 5px;
    transition-duration: 0.15s;
}

.vital-bar-fill--health {
    background-color: #E14242;
}

.vital-bar-fill--stamina {
    background-color: #84D444;
}

.vital-bar-fill--radiation {
    background-color: #2CD4C8;
}

/* =========================================================
   TOP-LEFT (BELOW VITALS): MISSION CARD
   ========================================================= */

.mission-card {
    position: absolute;
    left: 20px;
    top: 136px;
    width: 284px;
    flex-direction: column;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 4px;
    padding-right: 4px;
    background-color: rgba(0, 0, 0, 0);
}

.mission-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.mission-diamond {
    width: 8px;
    height: 8px;
    margin-right: 8px;
    background-color: #5CE8FF;
    border-width: 1px;
    border-color: rgba(220, 252, 255, 0.9);
    border-radius: 1px;
}

.mission-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: #5CE8FF;
    letter-spacing: 0.8px;
    white-space: normal;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9);
}

.mission-objective {
    font-size: 12px;
    color: rgba(240, 247, 252, 0.95);
    white-space: normal;
    margin-bottom: 3px;
    padding-left: 16px;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9);
}

.mission-substep {
    font-size: 11px;
    color: rgba(196, 218, 232, 0.86);
    white-space: normal;
    margin-bottom: 2px;
    padding-left: 16px;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9);
}

.mission-substep--completed {
    color: rgba(132, 212, 68, 0.85);
}

/* =========================================================
   TOP-RIGHT: RADAR CIRCLE
   ========================================================= */

.radar-circle {
    position: absolute;
    right: 22px;
    top: 18px;
    width: 146px;
    height: 146px;
    border-radius: 73px;
    background-color: rgba(14, 22, 34, 0.68);
    border-width: 1.5px;
    border-color: rgba(130, 175, 210, 0.55);
    overflow: hidden;
    justify-content: center;
    align-items: center;
}

.radar-ring-outer {
    position: absolute;
    width: 102px;
    height: 102px;
    border-radius: 51px;
    border-width: 1px;
    border-color: rgba(130, 175, 210, 0.28);
    background-color: rgba(0, 0, 0, 0);
}

.radar-ring-inner {
    position: absolute;
    width: 54px;
    height: 54px;
    border-radius: 27px;
    border-width: 1px;
    border-color: rgba(130, 175, 210, 0.22);
    background-color: rgba(0, 0, 0, 0);
}

.radar-crosshair-horizontal {
    position: absolute;
    width: 100%;
    height: 1px;
    background-color: rgba(130, 175, 210, 0.16);
}

.radar-crosshair-vertical {
    position: absolute;
    width: 1px;
    height: 100%;
    background-color: rgba(130, 175, 210, 0.16);
}

.radar-player-dot {
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: #FFFFFF;
    border-width: 1.5px;
    border-color: #5CE8FF;
}

.radar-blip {
    position: absolute;
    width: 7px;
    height: 7px;
    border-radius: 3.5px;
}

.radar-blip--hostile {
    background-color: #E14242;
    border-width: 1px;
    border-color: rgba(255, 200, 200, 0.75);
}

.radar-blip--objective {
    background-color: #5CE8FF;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.85);
}

.radar-blip--hazard {
    background-color: #2CD4C8;
}

.radar-blip--friendly {
    background-color: #84D444;
}

.radar-cardinal-north {
    position: absolute;
    top: 4px;
    font-size: 9px;
    -unity-font-style: bold;
    color: rgba(200, 232, 250, 0.78);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9);
}

/* =========================================================
   TOP-CENTER: BOSS CARD
   ========================================================= */

.boss-card {
    position: absolute;
    top: 18px;
    width: 420px;
    align-self: center;
    flex-direction: column;
    padding-top: 6px;
    padding-bottom: 8px;
    padding-left: 14px;
    padding-right: 14px;
    background-color: rgba(10, 14, 22, 0.44);
    border-width: 1px;
    border-color: rgba(225, 110, 72, 0.35);
    border-radius: 6px;
    transition-duration: 0.2s;
}

.boss-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 5px;
}

.boss-name {
    font-size: 13px;
    -unity-font-style: bold;
    color: #FFE4D4;
    letter-spacing: 1.2px;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9);
}

.boss-phase-label {
    font-size: 10px;
    -unity-font-style: bold;
    color: #F59E3D;
    letter-spacing: 0.8px;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9);
}

.boss-bar-track {
    width: 100%;
    height: 10px;
    border-radius: 5px;
    background-color: rgba(14, 10, 14, 0.72);
    border-width: 1px;
    border-color: rgba(245, 158, 61, 0.42);
    overflow: hidden;
    flex-direction: row;
    align-items: stretch;
}

.boss-bar-fill {
    height: 100%;
    border-radius: 5px;
    background-color: #D9383A;
    border-right-width: 3px;
    border-right-color: #F6A63B;
    transition-duration: 0.15s;
}

/* =========================================================
   BOTTOM-CENTER: CONTEXTUAL PROMPT BAR
   ========================================================= */

.contextual-prompt-bar {
    position: absolute;
    bottom: 64px;
    align-self: center;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 14px;
    padding-right: 14px;
    background-color: rgba(10, 16, 26, 0.42);
    border-width: 1px;
    border-color: rgba(245, 184, 72, 0.42);
    border-radius: 14px;
    transition-duration: 0.15s;
}

.prompt-key-badge {
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 7px;
    padding-right: 7px;
    margin-right: 8px;
    border-radius: 4px;
    background-color: rgba(245, 184, 72, 0.22);
    border-width: 1px;
    border-color: rgba(255, 206, 104, 0.85);
    font-size: 11px;
    -unity-font-style: bold;
    color: #FFD26E;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9);
}

.prompt-text {
    font-size: 12px;
    -unity-font-style: bold;
    color: #FFF6E3;
    letter-spacing: 0.5px;
    white-space: normal;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9);
}

/* =========================================================
   BOTTOM-CENTER: SLIM TOOLBAR
   ========================================================= */

.toolbar {
    position: absolute;
    bottom: 14px;
    align-self: center;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 6px;
    padding-right: 6px;
    background-color: rgba(8, 14, 24, 0.34);
    border-width: 1px;
    border-color: rgba(130, 175, 210, 0.22);
    border-radius: 8px;
}

.toolbar-slot {
    position: relative;
    width: 42px;
    height: 36px;
    margin-left: 3px;
    margin-right: 3px;
    border-radius: 5px;
    background-color: rgba(16, 26, 40, 0.48);
    border-width: 1px;
    border-color: rgba(140, 182, 214, 0.28);
    flex-direction: column;
    justify-content: center;
    align-items: center;
    transition-duration: 0.12s;
}

.toolbar-slot:hover {
    background-color: rgba(34, 54, 78, 0.62);
    border-color: rgba(92, 232, 255, 0.65);
}

.toolbar-slot--active {
    background-color: rgba(34, 70, 96, 0.66);
    border-color: #5CE8FF;
    border-width: 1.5px;
}

.toolbar-slot-key {
    position: absolute;
    top: 2px;
    left: 4px;
    font-size: 9px;
    -unity-font-style: bold;
    color: rgba(210, 230, 245, 0.78);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9);
}

.toolbar-slot-icon {
    width: 18px;
    height: 18px;
    opacity: 0.92;
}

.toolbar-slot-count {
    position: absolute;
    bottom: 2px;
    right: 4px;
    font-size: 9px;
    -unity-font-style: bold;
    color: #FFFFFF;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9);
}

/* =========================================================
   MODAL OVERLAYS (SHARED & SPECIFIC)
   ========================================================= */

.modal-overlay,
.title-login-overlay,
.pause-overlay,
.protocol-overlay,
.logbook-overlay,
.endgame-overlay,
#title-login-overlay,
#pause-overlay,
#protocol-overlay,
#logbook-overlay,
#endgame-overlay {
    position: absolute;
    left: 0px;
    top: 0px;
    right: 0px;
    bottom: 0px;
    width: 100%;
    height: 100%;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background-color: rgba(6, 10, 18, 0.72);
    transition-duration: 0.18s;
}

.title-login-overlay,
#title-login-overlay {
    background-color: rgba(6, 11, 20, 0.82);
}

.endgame-overlay,
#endgame-overlay {
    background-color: rgba(6, 10, 18, 0.84);
}

.modal-card {
    width: 460px;
    max-width: 90%;
    flex-direction: column;
    padding-top: 22px;
    padding-bottom: 22px;
    padding-left: 24px;
    padding-right: 24px;
    background-color: rgba(12, 20, 32, 0.92);
    border-width: 1px;
    border-color: rgba(130, 185, 224, 0.38);
    border-radius: 10px;
}

.modal-card--wide {
    width: 640px;
}

.modal-header {
    flex-direction: column;
    margin-bottom: 16px;
    padding-bottom: 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(130, 185, 224, 0.22);
}

.modal-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: #EAF6FF;
    letter-spacing: 1.4px;
    margin-bottom: 4px;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9);
}

.modal-subtitle {
    font-size: 12px;
    color: #5CE8FF;
    letter-spacing: 0.6px;
    white-space: normal;
}

.modal-body {
    flex-direction: column;
    margin-bottom: 18px;
}

.modal-body-text {
    font-size: 13px;
    color: rgba(224, 236, 246, 0.9);
    white-space: normal;
    margin-bottom: 10px;
}

.modal-field-label {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgba(175, 210, 235, 0.88);
    letter-spacing: 0.8px;
    margin-bottom: 5px;
}

.modal-input {
    height: 36px;
    padding-left: 10px;
    padding-right: 10px;
    margin-bottom: 12px;
    background-color: rgba(8, 14, 24, 0.85);
    border-width: 1px;
    border-color: rgba(130, 185, 224, 0.35);
    border-radius: 5px;
    color: #F2F9FF;
    font-size: 13px;
}

.modal-input:focus {
    border-color: #5CE8FF;
}

.modal-footer {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
}

.modal-footer--stacked {
    flex-direction: column;
    align-items: stretch;
}

.modal-button {
    height: 36px;
    padding-left: 18px;
    padding-right: 18px;
    margin-left: 8px;
    margin-bottom: 6px;
    background-color: rgba(24, 38, 58, 0.82);
    border-width: 1px;
    border-color: rgba(130, 185, 224, 0.42);
    border-radius: 5px;
    color: #E8F4FC;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 0.8px;
    -unity-text-align: middle-center;
    transition-duration: 0.14s;
}

.modal-button:hover {
    background-color: rgba(38, 62, 92, 0.92);
    border-color: #5CE8FF;
    color: #FFFFFF;
}

.modal-button--primary {
    background-color: rgba(30, 118, 148, 0.86);
    border-color: #5CE8FF;
    color: #FFFFFF;
}

.modal-button--primary:hover {
    background-color: rgba(44, 148, 182, 0.95);
}

.modal-button--danger {
    background-color: rgba(145, 36, 42, 0.82);
    border-color: rgba(225, 66, 66, 0.78);
    color: #FFEBEB;
}

.modal-button--danger:hover {
    background-color: rgba(185, 46, 52, 0.94);
    border-color: #E14242;
}

/* Protocol & Logbook Lists */
.protocol-list,
.logbook-list {
    max-height: 300px;
    flex-direction: column;
    overflow: hidden;
}

.protocol-item,
.logbook-entry {
    flex-direction: column;
    padding-top: 9px;
    padding-bottom: 9px;
    padding-left: 12px;
    padding-right: 12px;
    margin-bottom: 8px;
    background-color: rgba(16, 26, 42, 0.72);
    border-width: 1px;
    border-color: rgba(130, 175, 210, 0.24);
    border-radius: 6px;
}

.protocol-item-title,
.logbook-entry-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: #5CE8FF;
    margin-bottom: 3px;
}

.protocol-item-desc,
.logbook-entry-body {
    font-size: 12px;
    color: rgba(220, 234, 245, 0.88);
    white-space: normal;
}

/* Endgame Stats */
.endgame-stat-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 6px;
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(130, 175, 210, 0.14);
}

.endgame-stat-label {
    font-size: 12px;
    color: rgba(192, 214, 232, 0.86);
}

.endgame-stat-value {
    font-size: 13px;
    -unity-font-style: bold;
    color: #FFFFFF;
}

.endgame-status--victory {
    color: #84D444;
}

.endgame-status--defeat {
    color: #E14242;
}
